# RAG 知识库问答 —— 服务器部署环境变量
# 用法：cp .env.example .env 后按需填写（.env 已被 git 忽略，不会提交）
# 说明：本文件用于独立容器部署，复用主页 Caddy（docker_web 网络）按子域名反代。
#       其中 RAG_IMAGE_TAG / RAG_MEM_LIMIT / WEB_NETWORK 供 docker compose 插值，
#       其余变量经 env_file 注入容器。

# ---------- 镜像 / 编排 ----------
# CI 按 git sha 构建推送；部署时用同值指定，便于回滚
RAG_IMAGE_TAG=latest
# 主页 Caddy 所在的外部网络名（服务器上为 docker_web）
WEB_NETWORK=docker_web
# rag 容器内存上限（向量在独立 qdrant 后，512m 足够）
RAG_MEM_LIMIT=512m
# 独立 Qdrant 服务的镜像版本与内存上限（on_disk 下 800m 起步，按需调整）
QDRANT_IMAGE_TAG=v1.19.0
QDRANT_MEM_LIMIT=800m
# 容器时区（影响导入记录时间戳与日志；默认东八区）
TZ=Asia/Shanghai

# ---------- 运行模式 ----------
# 演示模式：每位访客按 cookie 隔离（独立目录 + 独立 Qdrant 集合）
DEMO_MODE=true
# 管理员令牌：保护模型配置 / 集合管理 / 会话管理等写操作，请务必设为强随机值
ADMIN_TOKEN=change-me-to-a-long-random-string

# ---------- 访客配额（仅访客生效，admin 不受限、永不被清理）----------
# 单访客知识库点数上限。实测单块约 12KB 磁盘，5000 块≈60MB，可容纳任意单个共享文档
VISITOR_MAX_POINTS=5000
# 所有访客集合合计点数上限；超出时淘汰最久未活跃访客的集合（仅集合+其导入账本）
VISITOR_GLOBAL_MAX_POINTS=150000
# 每 IP 每小时最多新建的访客身份数（0=不限）；计数落盘，重启不失效
VISITOR_MINT_PER_HOUR=20

# ---------- 向量库 ----------
# 独立 Qdrant 服务（推荐，配合 on_disk）；改用内嵌则填 ./qdrant_data
QDRANT_URL=http://qdrant:6333
# 可选：设置后需与 compose 的 QDRANT__SERVICE__API_KEY 一致
QDRANT_API_KEY=
QDRANT_COLLECTION=knowledge_base

# ---------- 对话模型（OpenCode Go，OpenAI 兼容）----------
# 首次启动会据此自动生成对话档案（provider=opencode-go）
LLM_PROVIDER=opencode-go
LLM_BASE_URL=https://opencode.ai/zen/go/v1
LLM_MODEL=deepseek-v4.1-flash
LLM_API_KEY=
LLM_TEMPERATURE=0

# ---------- 嵌入模型（SiliconFlow，OpenAI 兼容）----------
# 首次启动会据此自动生成嵌入档案（provider=siliconflow，维度需与集合一致）
EMBEDDING_PROVIDER=siliconflow
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=Pro/BAAI/bge-m3
EMBEDDING_API_KEY=
EMBEDDING_DIM=1024

# ---------- 分块 / 检索 ----------
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=3
CHUNKS_PER_FILE=3
RERANK_TOP_K=5
RRF_K=60
