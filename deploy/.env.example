# RAG 知识库问答 —— 服务器部署环境变量
# 用法：cp .env.example .env 后按需填写（.env 已被 git 忽略，不会提交）
# 说明：本文件用于独立容器部署，复用主页 Caddy（docker_web 网络）按子域名反代。
#       其中 RAG_IMAGE_TAG / RAG_MEM_LIMIT / WEB_NETWORK 供 docker compose 插值，
#       其余变量经 env_file 注入容器。

# ---------- 镜像 / 编排 ----------
# CI 按 git sha 构建推送；部署时用同值指定，便于回滚
RAG_IMAGE_TAG=latest
# 主页 Caddy 所在的外部网络名（服务器上为 docker_web）
WEB_NETWORK=docker_web
# 内存上限（内嵌 Qdrant 在启动时会载入已索引集合，集合变大后 512m 会 OOM；
# 2C2G 机器实测建议 1g，并结合 docker stats 与宿主机余量调整）
RAG_MEM_LIMIT=1g
# 容器时区（影响导入记录时间戳与日志；默认东八区）
TZ=Asia/Shanghai

# ---------- 运行模式 ----------
# 演示模式：每位访客按 cookie 隔离（独立目录 + 独立 Qdrant 集合）
DEMO_MODE=true
# 管理员令牌：保护模型配置 / 集合管理 / 会话管理等写操作，请务必设为强随机值
ADMIN_TOKEN=change-me-to-a-long-random-string

# ---------- 向量库 ----------
QDRANT_URL=./qdrant_data
QDRANT_COLLECTION=knowledge_base

# ---------- 对话模型（OpenCode Go，OpenAI 兼容）----------
# 首次启动会据此自动生成对话档案（provider=opencode-go）
LLM_PROVIDER=opencode-go
LLM_BASE_URL=https://opencode.ai/zen/go/v1
LLM_MODEL=deepseek-v4.1-flash
LLM_API_KEY=
LLM_TEMPERATURE=0

# ---------- 嵌入模型（SiliconFlow，OpenAI 兼容）----------
# 首次启动会据此自动生成嵌入档案（provider=siliconflow，维度需与集合一致）
EMBEDDING_PROVIDER=siliconflow
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=Pro/BAAI/bge-m3
EMBEDDING_API_KEY=
EMBEDDING_DIM=1024

# ---------- 分块 / 检索 ----------
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=3
CHUNKS_PER_FILE=3
RERANK_TOP_K=5
RRF_K=60
