# 复制为 .env(或由容器环境变量注入)

# Qdrant:本地目录模式 / :memory: / 远程 server
QDRANT_URL=./qdrant_data
QDRANT_COLLECTION=knowledge_base

# 向量(dense 走 Ollama /api/embed;sparse 走本地 FastEmbed bm25)
DENSE_EMBEDDING_MODEL=bge-m3

# LLM(走 Ollama /api/chat)
OLLAMA_MODEL=qwen2.5
OLLAMA_BASE_URL=http://localhost:11434

# 分块 / 检索
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=3
CHUNKS_PER_FILE=3
RERANK_TOP_K=5
RRF_K=60
