# 复制为 .env(或由容器环境变量注入)

# Qdrant:本地目录模式 / :memory: / 远程 server
QDRANT_URL=./qdrant_data
QDRANT_COLLECTION=knowledge_base

# 向量(dense 走 Ollama /api/embed;sparse 走本地 FastEmbed bm25)
DENSE_EMBEDDING_MODEL=bge-m3

# LLM(走 Ollama /api/chat)
OLLAMA_MODEL=qwen2.5
OLLAMA_BASE_URL=http://localhost:11434

# 分块 / 检索（env 为默认值；运行时可在管理面板「检索设置」调整，
# 落盘于 qdrant_data/retrieval_config.json，改完即时生效、无需重启）
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=3
CHUNKS_PER_FILE=3
# 融合后最多交给大模型的 chunk 数（0=不限制）
RERANK_TOP_K=0
RRF_K=60
# 混合检索：dense + sparse(BM25) 加权 RRF
HYBRID_ENABLED=true
DENSE_WEIGHT=1.0
SPARSE_WEIGHT=1.0
# 每路召回候选池 = max(TOP_K * CANDIDATE_MULTIPLIER, CANDIDATE_MIN)
CANDIDATE_MULTIPLIER=4
CANDIDATE_MIN=24
# 关键词通道权重与关键词个数上限（0 关闭关键词通道）
KEYWORD_BOOST=1.1
KEYWORD_LIMIT=5
# 组装上下文的总字符预算；dense 余弦分下限（0=不过滤）
MAX_CONTEXT_CHARS=4000
MIN_SCORE=0.0

# 大模型经博客 AI 网关(令牌在博客 admin「AI 密钥」页生成后填这里)。
# 不填 ZX_AI_GATEWAY_URL 时默认 http://localhost:3000/api/ai/v1(本地);
# 线上容器内设 http://app:3000/api/ai/v1(与博客同 docker 网络)。
ZX_AI_GATEWAY_URL=
ZX_AI_APP_TOKEN=
